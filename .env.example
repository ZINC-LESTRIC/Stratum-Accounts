# Database (Railway Postgres plugin provides DATABASE_URL automatically)
DATABASE_URL=postgresql+psycopg://reconai:change-me@localhost:5432/reconai

# Required in production — use a long random secret
RECONAI_JWT_SECRET=replace-with-a-long-random-secret

# true for first deploy / local; set false after schema exists
RECONAI_AUTO_CREATE_SCHEMA=true

# Dev-only header auth (never enable in production)
RECONAI_DEV_HEADER_AUTH=false

# Comma-separated list of allowed frontend origins (Vercel domains)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:8000,https://your-app.vercel.app

# Optional LLM (OpenAI-compatible)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4.1-mini
